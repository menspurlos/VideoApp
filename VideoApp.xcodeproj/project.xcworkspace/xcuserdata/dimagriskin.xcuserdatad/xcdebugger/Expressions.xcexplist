<?xml version="1.0" encoding="UTF-8"?>
<VariablesViewState
   version = "1.0">
   <ContextStates>
      <ContextState
         contextName = "AVPlayer.isPlaying.getter:VideoCollectionViewCell.swift">
         <PersistentStrings>
            <PersistentString
               value = "self.label">
            </PersistentString>
            <PersistentString
               value = "rate">
            </PersistentString>
         </PersistentStrings>
      </ContextState>
      <ContextState
         contextName = "VideoCollectionViewCell.startPlayback():VideoCollectionViewCell.swift">
         <PersistentStrings>
            <PersistentString
               value = "label.text">
            </PersistentString>
         </PersistentStrings>
      </ContextState>
      <ContextState
         contextName = "VideoCollectionViewCell.stopPlayback():VideoCollectionViewCell.swift">
         <PersistentStrings>
            <PersistentString
               value = "label.text">
            </PersistentString>
         </PersistentStrings>
      </ContextState>
      <ContextState
         contextName = "VideoCollectionViewCell.configure(with:):VideoCollectionViewCell.swift">
         <PersistentStrings>
            <PersistentString
               value = "String(describing: label.text)">
            </PersistentString>
         </PersistentStrings>
      </ContextState>
   </ContextStates>
</VariablesViewState>
